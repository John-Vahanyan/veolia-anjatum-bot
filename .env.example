# Copy this file to .env (or export these as real env vars / systemd
# Environment= lines) and fill in the values. Never commit a real .env.

# Required. Get a token from @BotFather on Telegram.
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Optional. Your bot's @username (used only for stripping "/command@YourBot"
# in group chats); harmless to leave blank for a private-chat-only bot.
BOT_USERNAME=

# Public channel to poll (no @, no t.me/ prefix). Preview page polled:
# https://t.me/s/<CHANNEL_USERNAME>
CHANNEL_USERNAME=VeoliaJur

# How often to poll the channel, in milliseconds.
POLL_INTERVAL_MS=90000

# Delay before the first poll after startup, in milliseconds.
POLL_INITIAL_DELAY_MS=5000

# Path to the SQLite database file. MUST point outside the build/output
# directory in production so redeploys never wipe subscriber data.
# Local dev default (see application.yml): ./data/bot.db
# Production example: /opt/veolia-bot/data/bot.db
BOT_DB_PATH=./data/bot.db
